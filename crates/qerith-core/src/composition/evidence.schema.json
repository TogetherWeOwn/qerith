{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qerith:composition:evidence:v1",
  "title": "Exact-build composition evidence (not authorization)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "authorization_ref", "product_sha", "engine_sha", "actions", "budgets", "scope", "cold_inventory", "engine_paths", "publication_order", "qualification_refs", "unavailable", "conclusion"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["synthetic", "authorized_live_window"]},
    "authorization_ref": {"type": "string", "minLength": 1},
    "product_sha": {"$ref": "#/$defs/sha"},
    "engine_sha": {"$ref": "#/$defs/sha"},
    "actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["head_sha", "run_url", "job_url", "conclusion"],
        "properties": {
          "head_sha": {"$ref": "#/$defs/sha"},
          "run_url": {"type": "string", "pattern": "^https://github.com/[^/]+/[^/]+/actions/runs/[0-9]+$"},
          "job_url": {"type": "string", "pattern": "^https://github.com/[^/]+/[^/]+/actions/runs/[0-9]+/job/[0-9]+$"},
          "conclusion": {"enum": ["success", "failure", "cancelled", "incomplete"]}
        }
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["max_bytes", "max_units", "max_attempts", "claim_seconds", "io_timeout_ms", "policy_version"],
      "properties": {
        "max_bytes": {"type": "integer", "minimum": 1},
        "max_units": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1},
        "claim_seconds": {"type": "integer", "minimum": 1},
        "io_timeout_ms": {"type": "integer", "minimum": 1},
        "policy_version": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant_alias", "generation", "intent_operation", "commit_operation", "job", "event", "ciphertext_length", "ciphertext_sha256", "checkpoint", "subscriber_count"],
      "properties": {
        "tenant_alias": {"type": "string", "minLength": 1},
        "generation": {"type": "string", "minLength": 1},
        "intent_operation": {"type": "string", "minLength": 1},
        "commit_operation": {"type": "string", "minLength": 1},
        "job": {"type": "string", "minLength": 1},
        "event": {"type": "string", "minLength": 1},
        "ciphertext_length": {"type": "integer", "minimum": 0},
        "ciphertext_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checkpoint": {"type": "integer", "minimum": 0},
        "subscriber_count": {"type": "integer", "minimum": 0}
      }
    },
    "cold_inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["hot_bytes", "safety_bytes", "staged_bytes", "hidden_cache_bytes", "inspection_ref"],
      "properties": {
        "hot_bytes": {"const": 0}, "safety_bytes": {"const": 0},
        "staged_bytes": {"const": 0}, "hidden_cache_bytes": {"const": 0},
        "inspection_ref": {"type": "string", "minLength": 1}
      }
    },
    "engine_paths": {"type": "array", "minItems": 1, "items": {"enum": ["retained_source_post", "article_retrieval", "yenc_validation", "par2_repair"]}, "uniqueItems": true},
    "publication_order": {
      "type": "array", "prefixItems": [
        {"const": "engine_retrieval"}, {"const": "whole_generation_verified"},
        {"const": "cache_complete"}, {"const": "conditional_catalogue_publication"},
        {"const": "scoped_serving_pin"}
      ], "minItems": 5, "maxItems": 5
    },
    "qualification_refs": {
      "type": "object", "additionalProperties": false,
      "required": ["independence", "readability", "reconstruction", "valid_until", "synthetic_only"],
      "properties": {
        "independence": {"type": "string", "minLength": 1},
        "readability": {"type": "string", "minLength": 1},
        "reconstruction": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "valid_until": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "synthetic_only": {"type": "boolean"}
      }
    },
    "unavailable": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "conclusion": {"enum": ["software_invariants_only", "window_pass_not_launch", "failed", "incomplete"]}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "synthetic"}}}, "then": {"properties": {"qualification_refs": {"properties": {"synthetic_only": {"const": true}}}, "conclusion": {"enum": ["software_invariants_only", "failed", "incomplete"]}}}},
    {"if": {"properties": {"kind": {"const": "authorized_live_window"}}}, "then": {"properties": {"qualification_refs": {"properties": {"synthetic_only": {"const": false}}}, "conclusion": {"enum": ["window_pass_not_launch", "failed", "incomplete"]}}}}
  ],
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
}
